{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-prime-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projet-db",
      "database_id": "985780b8-7be9-4ddb-9325-f6913c5349c1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "formation-s4-donnees"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://codex-prime-852.pages.dev,https://ben-scap.github.io,https://codex-prime-api.toupe-benoit.workers.dev",
    "TURNSTILE_HOSTNAME": "codex-prime-852.pages.dev",
    "TURNSTILE_ACTION": "soumission"
  }
}
