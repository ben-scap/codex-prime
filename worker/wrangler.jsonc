{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-prime-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "vars": {
    "ALLOWED_ORIGIN": "https://ben-scap.github.io",
    "ACCESS_APP_CONFIGURED": "false"
  },
  "r2_buckets": [
    {
      "binding": "OUTILS_BUCKET",
      "bucket_name": "formation-s4-donnees"
    }
  ]
}
