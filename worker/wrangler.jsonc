{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-prime-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "formation-s4-donnees"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://codex-prime-852.pages.dev,https://ben-scap.github.io",
    "TURNSTILE_HOSTNAME": "codex-prime-852.pages.dev",
    "TURNSTILE_ACTION": "soumission"
  }
}
